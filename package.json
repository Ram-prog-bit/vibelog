{
  "name": "vibelogapp",
  "version": "0.1.0",
  "description": "Local-first flight recorder for your coding agents — records live Claude Code sessions to your own disk and serves a dashboard on localhost.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "agents",
    "observability",
    "local-first",
    "dashboard",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vibelog": "bin/vibelog.mjs"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/diagnostics",
    "!.next/**/*.map",
    "public",
    "src",
    "pricing.json",
    "config.defaults.json",
    "next.config.ts",
    "tsconfig.json",
    "postcss.config.mjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "node bin/pricing.check.mjs && node bin/collector.check.mjs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "node-notifier": "^10.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
